# Copy to .env and edit. Never commit the real .env file.
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------------------------------------------
# sqlite3 = zero-config local development. postgresql = recommended for production.
DB_ENGINE=sqlite3
DB_NAME=deltablock
DB_USER=deltablock
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Browser / cross-origin ---------------------------------------------------------------------------------
# The Next.js app proxies /api/* to Django (same origin), so no CORS is needed by default.
# Only set these when the browser talks to Django on a different origin.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Sessions & security ------------------------------------------------------------------------------
SESSION_COOKIE_AGE=43200            # seconds of inactivity before a session expires (12 h)
REMEMBER_ME_AGE=1209600             # seconds a "Remember me" session lasts (14 days)
# Behind a TLS-terminating proxy set: SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_PROXY_SSL_HEADER=

# --- Demonstration behaviour --------------------------------------------------------------------------------
# DEMO MODE enables the prototype conveniences of the original UI: the "sign in as" personas, the
# "preview this page as" switch on Team and the "Open as <role>" buttons on the Screen map.
# It MUST be False in production.
DELTABLOCK_DEMO_MODE=True
# The prototype's fixed "today" used by the sample data (renewal countdowns, chart series). Demo data only.
DELTABLOCK_REFERENCE_DATE=2026-10-23
# Original messages tell the visitor whether an email is unknown / not set up yet. Set False for generic messages.
LOGIN_REVEAL_ACCOUNT_STATE=True

# --- Email (password reset) -----------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Deltablock <no-reply@deltablock.example>
